#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100
#define MOUSE 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

// AML クリックしたときにタイムアウトを延長

&mkp_input_listener { input-processors = <&zip_temp_layer 6 10000>; };

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        screenshot: screenshot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&to 7>,
                <&macro_press>,
                <&kp LEFT_WIN &kp LEFT_SHIFT &kp S>,
                <&macro_release>,
                <&kp LEFT_WIN &kp LEFT_SHIFT &kp S>;

            label = "SCREENSHOT";
        };

        shift_click: shift_click {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 6>, <&macro_press>, <&mkp MB3 &kp LEFT_SHIFT>;

            label = "SHIFT_CLICK";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
        };

        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q                 &kp W         &kp E         &kp R             &kp T                         &kp Y        &kp U          &kp I      &kp O            &kp P
&kp A                 &kp S         &kp D         &kp F             &kp G                         &kp H        &kp J          &kp K      &kp L            &kp SEMI
&mt LEFT_SHIFT Z      &kp X         &kp C         &kp V             &kp B                         &kp N        &kp M          &kp COMMA  &kp PERIOD       &kp MINUS
&mt LEFT_CONTROL TAB  &kp LEFT_WIN  &kp LEFT_ALT  &lt 4 LANG_HANJA  &lt 2 LANG1  &lt 3 SPACE      &lt 1 ENTER  &kp BACKSPACE  &kp ESC    &lt 5 BACKSLASH  &mt LEFT_ALT SLASH
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>,
                <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        function {
            bindings = <
&trans  &trans  &trans  &trans  &trans              &kp F1  &kp F2   &kp F3  &kp F4   &kp F5
&trans  &trans  &trans  &trans  &trans              &kp F6  &kp F7   &kp F8  &kp F9   &kp F10
&trans  &trans  &trans  &trans  &trans              &trans  &trans   &trans  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp DEL  &trans  &trans   &kp ESCAPE
            >;

            sensor-bindings = <&inc_dec_kp LC(MINUS) LC(SEMICOLON)>;
        };

        num {
            bindings = <
&kp N1                  &kp N2     &kp N3  &kp N4  &kp N5                  &kp N6  &kp N7     &kp N8    &kp N9     &kp N0
&kp GRAVE               &kp N4     &kp N5  &kp N6  &kp PLUS                &trans  &kp ASTRK  &kp FSLH  &kp MINUS  &kp EQUAL
&mt LEFT_SHIFT N0       &kp N1     &kp N2  &kp N3  &kp PERIOD              &trans  &trans     &trans    &trans     &trans
&mt LEFT_CONTROL EQUAL  &kp ENTER  &trans  &trans  &trans      &trans      &trans  &trans     &trans    &trans     &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        simbol {
            bindings = <
&kp EXCLAMATION  &kp AT  &kp HASH  &kp DOLLAR  &kp PERCENT              &kp CARET  &kp AMPERSAND  &kp ASTRK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&trans           &trans  &trans    &trans      &trans                   &trans     &trans         &kp LBKT   &kp RBKT              &kp SEMI
&trans           &trans  &trans    &trans      &trans                   &trans     &trans         &trans     &trans                &kp APOS
&trans           &trans  &trans    &trans      &trans       &trans      &trans     &trans         &trans     &trans                &trans
            >;

            sensor-bindings = <&inc_dec_kp 0 0>;
        };

        layer_4 {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))  &kp UP_ARROW    &kp LC(TAB)      &trans               &kp LS(LC(TAB))  &trans    &kp LC(TAB)      &trans     &trans
&kp HOME        &kp LEFT_ARROW   &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp END              &kp LEFT_ARROW   &kp DOWN  &kp UP           &kp RIGHT  &trans
&kp LEFT_SHIFT  &trans           &trans          &trans           &trans               &kp LG(TAB)      &trans    &kp LG(LS(TAB))  &trans     &trans
&trans          &trans           &trans          &trans           &trans   &trans      &trans           &trans    &trans           &trans     &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        BT {
            bindings = <
&trans  &trans  &trans  &trans  &trans              &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans              &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans              &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans      &trans        &trans        &trans        &trans        &bt BT_CLR_ALL
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans              &trans    &trans  &mkp MB3  &trans  &trans
&trans  &trans  &trans  &trans  &trans              &mkp MB1  &trans  &trans    &trans  &mkp MB2
&trans  &trans  &trans  &trans  &trans              &trans    &trans  &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans    &trans  &trans    &trans  &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_7 {
            bindings = <
&kp LC(Z)  &kp LC(Y)    &trans       &trans       &trans              &trans  &trans  &trans  &trans  &trans
&trans     &kp INS      &trans       &trans       &trans              &trans  &trans  &trans  &trans  &trans
&trans     &screenshot  &kp LC(INS)  &kp LS(INS)  &trans              &trans  &trans  &trans  &trans  &trans
&trans     &trans       &trans       &trans       &trans  &trans      &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp 0 0>;
        };
    };
};
